# 服务基础
ENV=dev # dev / prod
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_TOKEN=supersecret123456

# 数据库
DB_URL=sqlite:///./stock_data.db
DB_ECHO=false

# LLM配置
DEFAULT_LLM_PROVIDER=doubao
DOUBAO_API_KEY=sk-xxx
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-xxxx
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-coder-v2

# 限流
RATE_LIMIT_ENABLE=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_MIN=30

# 告警配置
ALERT_ENABLE=false
ALERT_WEBHOOK_DINGDING=
ALERT_WEBHOOK_WECOM=

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs/api
